# Environments and installs
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
node_modules/
dist/

# Secrets. Do not commit Hugging Face tokens.
.env
.env.*
!.env.example
*.pem

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Raw PDFs, HTML scrape cache, extracted PDF text (redownload / re-extract)
data/raw/

# Cue-control datasets (Hugging Face download, large)
data/real-controls*.jsonl
data/synthetic-controls.jsonl
data/nysed-*-incomplete.jsonl

# Giant trial logs and runner matrix (recreate from data/items.jsonl)
exports/trials.jsonl
exports/trials-census.jsonl
exports/trials-n2405.jsonl
exports/trial-marks.jsonl
exports/matrix.json

# Per-item GPU logs (recreate on CUDA; keep summary JSON)
exports/addendum-gpu/*-items.jsonl

# Choices-only Bedrock batch scratch (keep scored.jsonl)
exports/choices-only/batches/
exports/choices-only/predictions/
exports/choices-only/pending-*.json

# STAAR replication parse dumps and fetch logs (rebuild from PDFs)
exports/replication-staar/items.jsonl
exports/replication-staar/items-*.jsonl
exports/replication-staar/fetch-log*.md

# Rendered PDF page PNGs (recreate with scripts/render_pdf_pages.py)
exports/vision/
exports/print-audit/pages/
exports/addendum-vlm/pages/

# Human packet: send the tracked .txt, not the PDF
exports/human-masked-stem/rater-packet.pdf

# Hugging Face snapshots if copied into this tree
.cache/
huggingface/

# LaTeX auxiliaries (keep built paper PDFs)
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
